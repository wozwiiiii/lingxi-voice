# Database
POSTGRES_USER=lingxi
POSTGRES_PASSWORD=change-me-in-production
POSTGRES_DB=lingxi
DATABASE_URL=postgresql+asyncpg://lingxi:change-me-in-production@postgres:5432/lingxi

# Redis（加密码鉴权；REDIS_PASSWORD 需在部署前改为强随机值）
# db 0 = 缓存（TTS 结果/进度/限流），db 1 = 安全状态（JWT 黑名单/访客会话）
REDIS_PASSWORD=change-me-redis-password
REDIS_URL=redis://:change-me-redis-password@redis:6379/0
REDIS_SECURITY_DB=1

# JWT
JWT_SECRET_KEY=change-me-to-random-64-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# TTS Providers (comma-separated chain)
TTS_PROVIDER_CHAIN=local:cosyvoice2,cloud:siliconflow

# Local inference service
INFERENCE_SERVICE_URL=http://inference:8001

# SiliconFlow API
SILICONFLOW_API_KEY=sk-your-key-here
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1

# DeepSeek (LLM pipeline)
DEEPSEEK_API_KEY=sk-your-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com

# CORS
CORS_ORIGINS=http://localhost:5173,https://your-domain.com

# File storage
MEDIA_ROOT=/app/media
MAX_UPLOAD_SIZE_MB=20
